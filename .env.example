# ============================================================
# Agent 平台环境变量配置模板
# 复制此文件为 .env 后填入真实值：
#   cp .env.example .env
# ============================================================

# DeepSeek API Key（必填）
AGENT_DEEPSEEK_KEY=sk-your-deepseek-api-key-here

# OpenRouter API Key（可选）
# AGENT_OPENROUTER_KEY=sk-or-xxx

# 默认模型（可选，默认 deepseek-chat）
# AGENT_DEFAULT_MODEL=deepseek-v4-flash

# 数据库路径（可选）
# AGENT_DB_PATH=data/agent.db

# 服务端口（可选）
# AGENT_HOST=0.0.0.0
# AGENT_PORT=10004
